<?xml version="1.0"?>
<package format="3">
  <name>nuwa_vision</name>
  <version>0.1.0</version>
  <description>RGB-D ball and column detector for the Nuwa Bütian field.</description>
  <maintainer email="robotics@example.com">nuwa</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
